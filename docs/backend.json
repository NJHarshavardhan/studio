
{
  "entities": {
    "Candidate": {
      "title": "Candidate",
      "description": "Information about a job candidate extracted from a resume or provided during application.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "yearsOfExperience": { "type": "number" },
        "matchScore": { "type": "number" },
        "currentStage": { "type": "string", "enum": ["Applied", "AI Screening", "Shortlisted", "AI Interview", "HR Review", "Selected", "Rejected"] },
        "jobId": { "type": "string" },
        "resumeDataUri": { "type": "string" },
        "appliedDate": { "type": "string", "format": "date-time" },
        "interviewStatus": { "type": "string", "enum": ["none", "sent", "completed"] }
      },
      "required": ["name", "email", "currentStage", "jobId"]
    },
    "Job": {
      "title": "Job Opening",
      "description": "A job position available for applications.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["Open", "Closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "status"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Subscription details for the organization.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "planId": { "type": "string", "enum": ["free", "starter", "pro"] },
        "candidateLimit": { "type": "number" },
        "candidateCount": { "type": "number" },
        "status": { "type": "string" }
      }
    },
    "AdminConfig": {
      "title": "Admin Configuration",
      "description": "Global settings for the HireStack platform.",
      "type": "object",
      "properties": {
        "platformName": { "type": "string" },
        "aiApiKey": { "type": "string" },
        "maintenanceMode": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/candidates/{candidateId}": {
      "schema": "Candidate",
      "description": "Collection of candidates across all jobs."
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Collection of job openings."
    },
    "/subscriptions/{userId}": {
      "schema": "Subscription",
      "description": "Individual user or org subscription status."
    },
    "/admin/config": {
      "schema": "AdminConfig",
      "description": "Global platform configuration."
    }
  }
}
