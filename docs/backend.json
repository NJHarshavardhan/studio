
{
  "entities": {
    "Candidate": {
      "title": "Candidate",
      "description": "Information about a job candidate extracted from a resume or provided during application.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "yearsOfExperience": { "type": "number" },
        "matchScore": { "type": "number" },
        "currentStage": { "type": "string", "enum": ["Applied", "AI Screening", "Shortlisted", "AI Interview", "HR Review", "Selected", "Rejected"] },
        "jobId": { "type": "string" },
        "resumeDataUri": { "type": "string" },
        "appliedDate": { "type": "string", "format": "date-time" },
        "interviewStatus": { "type": "string", "enum": ["none", "sent", "completed"] }
      },
      "required": ["name", "email", "currentStage", "jobId"]
    },
    "Job": {
      "title": "Job Opening",
      "description": "A job position available for applications.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["Open", "Closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "status"]
    },
    "InterviewSession": {
      "title": "Interview Session",
      "description": "A record of an AI-driven interview session.",
      "type": "object",
      "properties": {
        "candidateId": { "type": "string" },
        "jobId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "score": { "type": "number" },
        "summary": { "type": "string" },
        "transcript": { "type": "string" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["candidateId", "jobId", "status"]
    },
    "EmailLog": {
      "title": "Email Log",
      "description": "A record of emails sent to candidates via the AI system.",
      "type": "object",
      "properties": {
        "candidateEmail": { "type": "string" },
        "candidateName": { "type": "string" },
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string" },
        "sentAt": { "type": "string", "format": "date-time" }
      },
      "required": ["candidateEmail", "subject", "body", "sentAt"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/candidates/{candidateId}": {
      "schema": "Candidate",
      "description": "Collection of candidates across all jobs."
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Collection of job openings."
    },
    "/interviews/{interviewId}": {
      "schema": "InterviewSession",
      "description": "Logs of AI interview sessions."
    },
    "/emails/{emailId}": {
      "schema": "EmailLog",
      "description": "Audit log of all AI-generated recruitment emails."
    }
  }
}
